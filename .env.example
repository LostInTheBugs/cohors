# Copy to .env and adjust, then: docker compose up -d --build

# Host port the app listens on (bound to 127.0.0.1 — put a reverse proxy in front).
PORT=8030

# Data directory (SQLite database + generated reports). Use the SAME absolute
# path on the host and in the container: it is passed as-is to the sibling
# SimulationCraft containers, so it must exist on the host filesystem.
DATA_DIR=/srv/cohors/data

# First admin account — created at startup when no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public base URL used to build invitation links (no trailing slash).
PUBLIC_BASE_URL=https://your-domain.example

# Battle.net API (https://develop.battle.net) — roster and character pages.
# Keys can also be set in the app: Settings -> Administration -> API keys.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# Optional overrides — the guild identity is also editable in the app
# (Settings -> Administration -> Guild).
# BNET_REGION=eu
# BNET_GUILD_REALM=your-realm
# BNET_GUILD_SLUG=your-guild
# BNET_LOCALE=fr_FR

# Warcraft Logs API (https://www.warcraftlogs.com/api/clients) — raid reports page.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Optional overrides:
# WCL_GUILD_NAME=Your Guild
# WCL_GUILD_REALM=your-realm
# WCL_GUILD_REGION=EU
# WCL_RAID_ZONE_ID=53     # current raid zone id (per-character parses on the comparison page)

# Outgoing e-mail (invitations) — SMTP submission account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cohors <noreply@example.com>

# Optional — voice portal (browser TeamSpeak client served behind the app login).
# COOKIE_DOMAIN=.your-domain.example   # share the session cookie with the voice subdomain
# VOICE_BACKEND=http://host.docker.internal:3040
# VOICE_PUBLIC_HOST=voice.your-domain.example
# VOICE_HEADER=X-Cohors-Voice          # gate header set by the voice vhost

# Optional tuning (defaults shown)
# QUEUE_MAX=20           # max simulations waiting + running
# PER_IP_ACTIVE=3        # max queued/running simulations per IP
# PER_USER_ACTIVE=3      # max queued/running simulations per account
# PER_IP_COOLDOWN_S=15   # minimum delay between two submissions from one IP
# SIM_TIMEOUT=900        # hard timeout per simulation (seconds)
# SIMC_IMAGE=simulationcraftorg/simc:latest
# SESSION_DAYS=30        # session cookie lifetime
# INVITE_TTL_DAYS=7      # invitation link validity
# COOKIE_SECURE=1        # set to 0 for plain-HTTP local development only
# BOT_POLL_S=300         # Discord bot announcement interval (seconds)
# SNAPSHOT_REFRESH_MIN=360   # re-snapshot delay for linked characters (minutes)
# SNAPSHOT_REFRESH_MIN_OTHER=1200  # roster re-snapshot delay (minutes)
