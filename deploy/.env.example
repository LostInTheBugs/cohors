# Cohors — first-start settings. Copy to .env and edit the three marked values.
# Everything else (Battle.net / Warcraft Logs keys, guild identity, SMTP, Discord bot, branding)
# is configured inside the app: Settings → Administration — follow the 🚀 first-time setup checklist
# (/start, linked from the dashboard for admins until every step is done).
# Optional tuning (SIM_*, VOICE_*, TRUSTED_PROXY_HOPS, …) is documented in the main .env.example
# of the repository.

# Host port the app listens on (bound to 127.0.0.1 — put a reverse proxy in front for TLS).
PORT=8030

# Data directory: absolute path, SAME on host and in the container. It must exist on the host and
# be writable by APP_UID below (database + generated reports live there).
DATA_DIR=/srv/cohors/data

# uid the app container runs as. Set it to the host user owning DATA_DIR.
APP_UID=1000

# First admin account — created at startup when no admin exists yet.
# Once signed in, change the password from the app and REMOVE the ADMIN_PASSWORD line below.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public base URL used to build invitation links (no trailing slash).
PUBLIC_BASE_URL=https://cohors.example.com
